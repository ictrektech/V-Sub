# Main-process-only update: keep the published UI and native model runtimes.
ARG WORKBENCH_IMAGE
ARG BASE_IMAGE
FROM ${WORKBENCH_IMAGE} AS build
WORKDIR /opt/v-sub
COPY . .
RUN node node_modules/typescript/bin/tsc --noEmit --incremental false -p main/tsconfig.json \
 && VSUB_WEB=1 node scripts/build-automation-backend.cjs

FROM ${BASE_IMAGE}
COPY --from=build /opt/v-sub/app/background.js /opt/v-sub/app/preload.js /opt/v-sub/app/
COPY --from=build /opt/v-sub/vos /opt/v-sub/vos
